# server
HOST = 0.0.0.0
HOST_PORT=5000
PORT=5000
MAX_UPLOAD_MB=10

# postgres
DB_NAME=native_upload
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# docker only, so it won't clash with local postgres
DB_HOST_PORT=5433

# true logs every SQL query
DB_LOGGING=false

# docker only. blank = use the postgres container.
# set them to use an outside postgres.
DB_HOST_DOCKER=
DB_PORT_DOCKER=
