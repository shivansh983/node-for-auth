# phone connects here
HOST_PORT=5000

# inside container
PORT=5000

# upload limit (MB)
MAX_UPLOAD_MB=10

# jwt
JWT_SECRET=change-me

# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=uploads

# docker: @db  local: @localhost
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uploads
POSTGRES_PORT=5432
